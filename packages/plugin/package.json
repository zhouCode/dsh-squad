{
  "name": "@dsh-squad/plugin",
  "version": "0.7.0",
  "description": "DSH-native delegation for distributed teams of independently owned personal Agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhouCode/dsh-squad.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/zhouCode/dsh-squad#readme",
  "bugs": {
    "url": "https://github.com/zhouCode/dsh-squad/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "personal-agent",
    "agent-delegation",
    "multi-agent"
  ],
  "type": "module",
  "main": "dist/host/plugin.js",
  "types": "dist/host/plugin.d.ts",
  "bin": {
    "dsh-squad-update": "./dist/updater/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/host/plugin.d.ts",
      "default": "./dist/host/plugin.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/host/**/*.js",
    "dist/host/**/*.d.ts",
    "dist/shared/**/*.js",
    "dist/shared/**/*.d.ts",
    "dist/update/**/*.d.ts",
    "dist/updater/**/*.js",
    "dist/updater/**/*.d.ts",
    "dist/client.js",
    "dist/client/index.d.ts",
    "cordis.patch.yml",
    "release-signing-public.pem",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-runtime.mjs && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm pack --pack-destination ../../artifacts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "24.10.13",
    "@types/react": "18.3.27",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zod": "4.0.17"
  }
}
